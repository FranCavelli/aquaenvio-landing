---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Comparativa from '../components/Comparativa.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const title = 'Aquaenvio vs Yaku, Sodapp, Nexo Repartos, Centra, Repartito y más: comparativa';
const description =
  'Comparativa de funciones de los sistemas para soderías y reparto de agua en Argentina: Aquaenvio, Yaku, Sodapp, Nexo Repartos, TrackMyVend, Centra, Repartito, Repartix, App Delivery Agua, Gestión Aguas, JR-Software, Reparto de Agua y reparto.cloud. Envases, stock del camión, planta, roles, factura ARCA y cobro con QR. Probalo gratis 1 semana.';
---

<Base title={title} description={description} path="/comparativa">
  <Nav base="/" />
  <main>
    <PageHeader
      badge="Comparativa honesta"
      title="Aquaenvio vs los demás sistemas de reparto de agua"
      subtitle="Qué trae cada sistema para sodería o distribuidora de agua en Argentina, según lo que publica cada uno en su web: Yaku, Sodapp, Nexo Repartos, TrackMyVend, Centra, Repartito, Repartix, App Delivery Agua, Gestión Aguas, JR-Software, Reparto de Agua y reparto.cloud."
    />
    <Comparativa />
    <CTA />
  </main>
  <Footer />
</Base>
