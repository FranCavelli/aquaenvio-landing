---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Comparativa from '../components/Comparativa.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const title = 'Aquaenvio vs Sodapp, Yaku, Gestión Aguas y más: precios y funciones';
const description =
  'Comparativa de precios y funciones de los sistemas para reparto de agua y soderías en Argentina: Aquaenvio, Sodapp, Yaku, App Delivery Agua, Gestión Aguas, JR-Software y Reparto de Agua. Probalo gratis 1 semana.';
---

<Base title={title} description={description} path="/comparativa">
  <Nav base="/" />
  <main>
    <PageHeader
      badge="Comparativa honesta"
      title="Aquaenvio vs los demás sistemas de reparto de agua"
      subtitle="Cuánto cuesta y qué trae cada sistema para sodería o distribuidora de agua en Argentina: Sodapp, Yaku, App Delivery Agua, Gestión Aguas, JR-Software y Reparto de Agua."
    />
    <Comparativa />
    <CTA />
  </main>
  <Footer />
</Base>
