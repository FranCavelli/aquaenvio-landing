---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import PageHeader from '../components/PageHeader.astro';
import Showcase from '../components/Showcase.astro';
import Contenido from '../components/Contenido.astro';
import Novedades from '../components/Novedades.astro';
import CTA from '../components/CTA.astro';
import Footer from '../components/Footer.astro';

const title = 'Funciones del software de reparto de agua | Aquaenvio';
const description =
  'Repartos, clientes, ventas, pedidos, carga y descarga, caja, envases en comodato, mapas en vivo y facturación ARCA. Todo lo que una distribuidora de agua necesita, en una sola app.';
---

<Base title={title} description={description} path="/funciones">
  <Nav base="/" />
  <main>
    <PageHeader
      badge="Contenido"
      title="Todo lo que hoy está en el cuaderno"
      subtitle="Un módulo por cada parte del reparto: recorrido, clientes, ventas, envases, caja, mapa y facturación. Ninguno se paga aparte."
    />
    <Showcase />
    <Contenido />
    <Novedades />
    <CTA />
  </main>
  <Footer />
</Base>
