---
/* Layout de la portada nueva: el mismo <head> de SEO y el mismo seguimiento que Base.astro,
   pero con su propio CSS (sin Tailwind ni GSAP: la portada no los usa y así carga menos). */
import '../styles/portada.css';
import SeoHead from '../components/SeoHead.astro';
import Seguimiento from '../components/Seguimiento.astro';

interface Props { title?: string; description?: string; path?: string; ogImage?: string }
const {
  title = 'Aquaenvio · Sistema de gestión para soderías y distribuidoras de agua',
  description = 'El sistema de gestión para soderías y distribuidoras de agua: clientes y lo que debe cada uno, repartos con GPS, sifones y bidones prestados, ventas sin señal, cobro con QR de Mercado Pago, caja y factura electrónica. Sirve para cualquier reparto a domicilio. Desde $15.999 por mes, 1 semana gratis.',
  path = '/',
  ogImage = 'https://aquaenvio.com/images/og.jpg',
} = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <SeoHead title={title} description={description} path={path} ogImage={ogImage} />
    <!-- Lo primero que se ve: la portada del panel en la notebook (mejora el LCP). -->
    <link rel="preload" as="image" href="/portada/dashboard.webp" imagesrcset="/portada/dashboard-640.webp 640w, /portada/dashboard.webp 1000w" imagesizes="(max-width: 760px) 96vw, 780px" fetchpriority="high" />
  </head>
  <body>
    <slot />
    <script>
      import '../scripts/portada.ts';
    </script>
    <Seguimiento />
  </body>
</html>
