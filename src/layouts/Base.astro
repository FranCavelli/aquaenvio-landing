---
import '../styles/global.css';
import { REDES, CONTACTO } from '../config';

interface Props {
  title?: string;
  description?: string;
  path?: string; // ruta para el canonical, ej: "/comparativa"
  ogImage?: string;
}

const {
  title = 'Aquaenvio · Software para reparto de agua, soda y soderías',
  description = 'Sistema para distribuidoras de agua y soda: repartos con navegación GPS por voz, pedidos por WhatsApp, cobro con QR, envases, caja y facturación electrónica desde el celular del repartidor (anda sin señal). Probalo gratis 1 semana.',
  path = '/',
  ogImage = 'https://aquaenvio.com/images/og.jpg',
} = Astro.props;

const SITE = 'https://aquaenvio.com';

// El canonical SIEMPRE termina en barra. GitHub Pages sirve la pagina en
// /funciones/ y responde 301 en /funciones; si el canonical apunta a la version
// sin barra, Google llega a la pagina, lee un canonical que lleva a una
// redireccion y NO la indexa. Paso de verdad: de 4 paginas quedaba indexada
// solo la home, que es la unica donde la URL ya coincide consigo misma.
const canonical = SITE + (path.endsWith('/') ? path : path + '/');

// Datos estructurados para Google.
//
// Van los TRES tipos juntos en un @graph, no solo el software:
//   - Organization + WebSite le dicen a Google que la marca "Aquaenvio" ES este
//     dominio. Sin eso, buscando "aquaenvio" a secas Google no sabe que el
//     dominio es el sitio oficial y rankea antes los posteos de Instagram.
//   - sameAs cierra el circuito con los perfiles: el perfil ya enlaza al sitio,
//     ahora el sitio enlaza al perfil. Google usa ese ida y vuelta para
//     confirmar la identidad de la marca.
// Los @id son anclas internas del grafo (no son URLs que haya que crear).
const ORG_ID = SITE + '/#organizacion';
const WEB_ID = SITE + '/#sitio';

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': ORG_ID,
      name: 'Aquaenvio',
      alternateName: ['AquaEnvio', 'Aqua Envio'],
      url: SITE,
      logo: {
        '@type': 'ImageObject',
        url: SITE + '/images/apple-touch-icon.png',
        width: 180,
        height: 180,
      },
      image: ogImage,
      description:
        'Sistema de gestión para distribuidoras de agua, soda y soderías: repartos, clientes, envases, caja y facturación AFIP.',
      areaServed: { '@type': 'Country', name: 'Argentina' },
      sameAs: [REDES.instagram, REDES.facebook],
      contactPoint: {
        '@type': 'ContactPoint',
        contactType: 'sales',
        telephone: '+' + CONTACTO.whatsapp,
        email: CONTACTO.email,
        areaServed: 'AR',
        availableLanguage: ['es-AR'],
      },
    },
    /* El nombre que Google muestra arriba de cada resultado ("Aquaenvio" en vez
       de "aquaenvio.com") sale de ACÁ. Dos condiciones que pide Google y que
       antes no se cumplían:
         - `url` tiene que ser EXACTAMENTE la canónica de la home, con la barra
           final (sin barra no coincidía y Google mostraba el dominio);
         - `alternateName` con las otras formas del nombre, por si elige otra. */
    {
      '@type': 'WebSite',
      '@id': WEB_ID,
      name: 'Aquaenvio',
      alternateName: ['AquaEnvio', 'Aqua Envio'],
      url: SITE + '/',
      inLanguage: 'es-AR',
      publisher: { '@id': ORG_ID },
    },
    {
      '@type': 'SoftwareApplication',
      name: 'Aquaenvio',
      applicationCategory: 'BusinessApplication',
      operatingSystem: 'Web, Android, iOS',
      description,
      url: SITE,
      inLanguage: 'es-AR',
      publisher: { '@id': ORG_ID },
      offers: {
        '@type': 'Offer',
        priceCurrency: 'ARS',
        description: 'Suscripción mensual en pesos. 1 semana de prueba gratis sin tarjeta.',
      },
      areaServed: { '@type': 'Country', name: 'Argentina' },
      audience: {
        '@type': 'BusinessAudience',
        name: 'Soderías y distribuidoras de agua, soda y bebidas',
      },
    },
  ],
};
---

<!doctype html>
<html lang="es" class="no-js">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="keywords" content="software reparto de agua, sistema para sodería, app reparto de agua, gestión distribuidora de agua, software soda y agua, control de envases, facturación AFIP sodería, reparto de agua Argentina" />
    <meta name="theme-color" content="#0a2e4d" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/apple-touch-icon.png" />

    <!-- Open Graph (preview en WhatsApp / redes) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Aquaenvio" />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Datos estructurados para Google -->
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />

    <!-- Fuente Inter (carga no bloqueante) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      as="style"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Archivo:wdth,wght@75..125,400..900&display=swap"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Archivo:wdth,wght@75..125,400..900&display=swap"
      />
    </noscript>

    <title>{title}</title>

    <!-- Quita la clase no-js apenas corre JS -->
    <script is:inline>
      document.documentElement.classList.remove('no-js');
    </script>
    <noscript>
      <style>[data-reveal]{opacity:1;transform:none}</style>
    </noscript>
  </head>
  <body class="bg-slate-50 text-slate-800 overflow-x-hidden">
    <slot />

    <!-- Animaciones globales (GSAP + ScrollTrigger) -->
    <script>
      import '../scripts/animations.ts';
    </script>

    <!-- Registro de visita (IP + ubicación vía Cloudflare) en el backend de la app.
         Best-effort, fire-and-forget; el server dedup 1 por IP cada 30 min. -->
    <script is:inline>
      (function () {
        try {
          var url = 'https://aquaenvio.sbs/api/cotizar/visita?origen=landing';
          if (navigator.sendBeacon) navigator.sendBeacon(url);
          else fetch(url, { method: 'POST', mode: 'no-cors', keepalive: true }).catch(function () {});
        } catch (e) {}
      })();
    </script>

    <!-- Embudo: qué hace la visita ADENTRO (secciones que ve, cuánto se queda,
         si toca WhatsApp/Mail) → panel Visitas de la app. Sesión = id al azar
         de esta pestaña; los utm del anuncio se guardan de la URL de llegada.
         El server deja una fila por (sesión, paso): repetir no suma. -->
    <script is:inline>
      (function () {
        try {
          var URL_EV = 'https://aquaenvio.sbs/api/cotizar/evento';
          var ss = window.sessionStorage;
          var s = ss.getItem('aq_s');
          var nueva = !s;
          if (!s) { s = Math.random().toString(36).slice(2) + Date.now().toString(36); ss.setItem('aq_s', s); }
          var q = new URLSearchParams(location.search);
          if (q.get('utm_source')) {
            ss.setItem('aq_utm', JSON.stringify({ us: q.get('utm_source'), uc: q.get('utm_campaign') || '', ut: q.get('utm_content') || '' }));
          }
          var utm = JSON.parse(ss.getItem('aq_utm') || '{}');
          function ev(t, d) {
            var p = new URLSearchParams({ s: s, t: t, d: d || '', us: utm.us || '', uc: utm.uc || '', ut: utm.ut || '' });
            if (navigator.sendBeacon) navigator.sendBeacon(URL_EV, p);
            else fetch(URL_EV, { method: 'POST', body: p, mode: 'no-cors', keepalive: true }).catch(function () {});
          }
          if (nueva) ev('entrada');

          // Secciones vistas (al menos un 40% en pantalla).
          if ('IntersectionObserver' in window) {
            var io = new IntersectionObserver(function (es) {
              es.forEach(function (e) { if (e.isIntersecting) { ev('seccion', e.target.id); io.unobserve(e.target); } });
            }, { threshold: 0.4 });
            document.querySelectorAll('section[id]').forEach(function (el) { io.observe(el); });
          }

          // Hasta dónde bajó (25/50/75/100% del largo de la página), una vez cada marca.
          var hondo = 0;
          var marcasScroll = [25, 50, 75, 100];
          function medirScroll() {
            var alto = document.documentElement.scrollHeight - window.innerHeight;
            var pct = alto > 0 ? Math.round((window.scrollY / alto) * 100) : 100;
            marcasScroll.forEach(function (m) { if (pct >= m && hondo < m) { hondo = m; ev('scroll', String(m)); } });
          }
          var esperaScroll = null;
          window.addEventListener('scroll', function () {
            if (esperaScroll) return;
            esperaScroll = setTimeout(function () { esperaScroll = null; medirScroll(); }, 400);
          }, { passive: true });

          // Tiempo en la página (solo cuenta mientras la pestaña está visible).
          var seg = 0;
          var marcas = [15, 30, 60, 120];
          setInterval(function () {
            if (document.visibilityState !== 'visible') return;
            seg++;
            if (marcas.indexOf(seg) >= 0) ev('tiempo', String(seg));
          }, 1000);

          // El momento clave: tocar WhatsApp o Mail.
          document.addEventListener('click', function (e) {
            var a = e.target && e.target.closest ? e.target.closest('a[href]') : null;
            if (!a) return;
            var h = a.getAttribute('href') || '';
            // Tocar WhatsApp queda registrado con el anuncio de la visita (utm): el panel
            // Comercial empareja ese toque con el mensaje que entra minutos después, sin
            // tocar el texto del mensaje (Francisco no quiere nada visible ahí).
            if (h.indexOf('wa.me') >= 0 || h.indexOf('whatsapp') >= 0) ev('contacto', 'whatsapp');
            else if (h.indexOf('mailto:') === 0) ev('contacto', 'mail');
          }, true);
        } catch (e) {}
      })();
    </script>

    <!-- Microsoft Clarity: grabaciones anónimas y mapas de calor (proyecto "Aquaenvio landing"). -->
    <script is:inline>
      (function(c,l,a,r,i,t,y){
        c[a]=c[a]||function(){(c[a].q=c[a].q||[]).push(arguments)};
        t=l.createElement(r);t.async=1;t.src="https://www.clarity.ms/tag/"+i;
        y=l.getElementsByTagName(r)[0];y.parentNode.insertBefore(t,y);
      })(window, document, "clarity", "script", "yvoagvgr5p");
    </script>
  </body>
</html>
