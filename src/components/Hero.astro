---
import { whatsappUrl } from '../config';
import Bidon from './Bidon.astro';

// EL BIDÓN, parado y a contraluz.
//
// El objeto manda: un bidón de 20 litros dibujado, con su etiqueta, que se va
// llenando de agua mientras bajás la página. El titular va serigrafiado sobre
// el plástico, al lado, y la ficha del producto en la etiqueta blanca de abajo.

const ficha: [string, string][] = [
  ['Contenido', 'Reparto, clientes, envases, caja y facturación'],
  ['Modo de uso', 'Desde el navegador o instalada como app'],
  ['Conservación', 'Anda sin señal: guarda y sincroniza al volver'],
  ['Vencimiento', 'No tiene: sin permanencia, cortás cuando quieras'],
  ['Soporte', 'Por WhatsApp, con una persona del otro lado'],
];
---

<section id="top" class="envase relative isolate overflow-hidden bg-pc-900">
  <!-- Luz de atrás: el envase está contra la ventana. -->
  <div
    class="pointer-events-none absolute inset-0 -z-20"
    aria-hidden="true"
    style="background: radial-gradient(85% 65% at 68% 34%, #1478E0 0%, #0B4FA8 30%, #06305C 58%, #041B33 86%)"
  >
  </div>

  <!-- Gotas de condensación sobre el plástico. -->
  <div class="pointer-events-none absolute inset-0 -z-10 opacity-70" aria-hidden="true">
    {
      [
        [12, 22, 5], [21, 61, 3], [8, 78, 4], [31, 15, 2.5], [46, 84, 3.5],
        [58, 26, 2], [72, 71, 4.5], [88, 38, 3], [94, 66, 2.5], [65, 12, 3],
      ].map(([left, top, r]) => (
        <span
          class="absolute rounded-full bg-white/20 shadow-[inset_0_-1px_2px_rgba(255,255,255,.5)]"
          style={`left:${left}%; top:${top}%; width:${r * 2}px; height:${r * 2.4}px`}
        />
      ))
    }
  </div>

  <div class="relative mx-auto grid max-w-[1180px] items-center gap-8 px-5 pb-14 pt-32 sm:gap-10 sm:px-9 lg:grid-cols-[1.15fr_minmax(0,380px)] lg:gap-16 lg:pb-20 lg:pt-32">
    <!-- Serigrafía sobre el plástico.
         SIN data-reveal a propósito: el titular es el elemento más grande de
         la primera pantalla, y si arranca en opacity 0 esperando a GSAP, en un
         celular barato la página se ve vacía hasta que carga el script (y si
         el script falla, para siempre). -->
    <div class="order-2 lg:order-1">
      <h1 class="t-marca serigrafia text-[2.35rem] sm:text-6xl lg:text-[4.25rem]">
        El cuaderno del reparto, adentro del celular
      </h1>
      <p class="mt-7 max-w-[48ch] text-[1.0625rem] leading-relaxed text-pc-100/90">
        El repartidor carga la venta en la puerta del cliente, aunque no haya
        señal. En la misma cuenta quedan el saldo, los envases prestados y la
        factura. Vos ves el día cerrado desde el celular.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-x-8 gap-y-4">
        <a
          href={whatsappUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="precinto t-legal inline-flex items-center gap-2.5 px-7 py-4 text-[12px] transition hover:brightness-105 active:translate-y-px"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
          Probar una semana gratis
        </a>
        <a href="#app" class="t-legal text-[12px] text-white underline decoration-2 underline-offset-[7px] transition hover:text-luz">
          Ver la app andando
        </a>
      </div>

      <p class="t-legal mt-8 text-[10px] text-pc-100/85">
        Sin tarjeta · Sin permanencia · Los 2 primeros meses van al costo
      </p>
    </div>

    <!-- El envase. En el celular va PRIMERO: si queda debajo del texto, lo
         primero que se ve es una pantalla azul sin una gota de agua. -->
    <div class="relative order-1 mx-auto w-[128px] sm:w-[190px] lg:order-2 lg:w-full lg:max-w-[360px]">
      <Bidon marca="Aquaenvio" bajada="Software de reparto" class="w-full" />
      <!-- Con el envase chico, la bajada de la etiqueta no se lee: va acá, a
           tamaño de lectura, para que no quede sólo un bidón de agua. -->
      <p class="t-legal mt-3 text-center text-[10px] text-pc-100/90 lg:hidden">
        Software de reparto
      </p>
      <!-- Indicador de nivel, como el del costado del envase. -->
      <div class="pointer-events-none absolute -left-2 bottom-[14%] hidden select-none sm:block" aria-hidden="true">
        <div class="flex items-end gap-2">
          <div>
            <p class="t-legal text-right text-[9px] text-white/90">Nivel</p>
            <p class="t-dato mt-0.5 text-right text-lg text-white/90"><span data-nivel-num>3</span> L</p>
          </div>
          <div class="h-12 w-px bg-white/40"></div>
        </div>
      </div>
    </div>
  </div>

  <!-- La etiqueta: la ficha del producto, en papel, pegada abajo del envase. -->
  <div class="relative mx-auto max-w-[1180px] sm:px-6" >
    <div class="etiqueta relative">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-label-200 px-5 py-3 sm:px-9">
        <p class="t-legal text-[11px] text-ink">Aquaenvio</p>
        <p class="t-legal text-[11px] text-inksoft">Software de reparto · Argentina</p>
      </div>

      <dl class="grid gap-x-10 px-5 py-7 sm:grid-cols-2 sm:px-9 lg:grid-cols-3">
        {
          ficha.map(([k, v]) => (
            <div class="border-b border-label-200 py-3 last:border-b-0 sm:border-b">
              <dt class="t-legal text-[10px] text-inksoft">{k}</dt>
              <dd class="mt-1 text-[0.9375rem] leading-snug text-ink">{v}</dd>
            </div>
          ))
        }
        <div class="py-3">
          <dt class="t-legal text-[10px] text-inksoft">Origen</dt>
          <dd class="mt-1 text-[0.9375rem] leading-snug text-ink">Argentina. Precio en pesos</dd>
        </div>
      </dl>
    </div>
  </div>

  <!-- La línea del agua: el corte con la sección de abajo no es recto. -->
  <svg class="relative -mb-px block w-full" viewBox="0 0 1200 60" preserveAspectRatio="none" aria-hidden="true" style="height:52px">
    <path d="M0 26 C 180 6 320 46 520 32 C 720 18 860 52 1040 38 C 1120 32 1170 26 1200 22 L1200 60 L0 60 Z" fill="#041B33"></path>
    <path d="M0 26 C 180 6 320 46 520 32 C 720 18 860 52 1040 38 C 1120 32 1170 26 1200 22" fill="none" stroke="#9BDDFA" stroke-opacity="0.5" stroke-width="2"></path>
  </svg>
</section>

<script>
  // EL MOMENTO ANIMADO: el bidón se llena mientras bajás. Se escribe una sola
  // variable CSS (--nivel) y el resto lo resuelve el SVG.
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';

  gsap.registerPlugin(ScrollTrigger);

  const envase = document.querySelector<HTMLElement>('.envase');
  const numero = document.querySelector<HTMLElement>('[data-nivel-num]');

  if (envase) {
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      envase.style.setProperty('--nivel', '1');
      if (numero) numero.textContent = '20';
    } else {
      ScrollTrigger.create({
        trigger: envase,
        start: 'top top',
        end: 'bottom top',
        scrub: 0.4,
        onUpdate: (self) => {
          const nivel = 0.14 + self.progress * 0.86;
          envase.style.setProperty('--nivel', nivel.toFixed(3));
          if (numero) numero.textContent = String(Math.round(nivel * 20));
        },
      });
    }
  }
</script>
