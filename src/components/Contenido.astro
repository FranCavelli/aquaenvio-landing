---
// CONTENIDO — la lista de lo que trae el envase.
//
// En una etiqueta el contenido no se cuenta con tarjetas y dibujitos: va en una
// lista apretada, con renglones, y el que necesita el dato lo encuentra. Los
// módulos son los de la app, escritos como los nombra alguien del rubro.

const modulos: [string, string][] = [
  ['Repartos', 'El recorrido del día en orden. Registrás la venta, el cobro y los envases, y deshacés con un toque si te equivocaste.'],
  ['Clientes', 'Ficha, saldo, precios propios de ese cliente, historial y cada cuántas semanas hay que pasar.'],
  ['Ventas', 'Todo lo vendido y cobrado, por día, por repartidor y por cliente.'],
  ['Pedidos', 'Lo que pidieron y los "para mañana", fijados arriba hasta que les vendas.'],
  ['Carga y descarga', 'Lo que subió al camión, lo que volvió y el cierre del día.'],
  ['Caja y gastos', 'La caja diaria, los gastos y el cierre.'],
  ['Envases', 'Cuántos bidones tiene prestado cada cliente y desde cuándo. Con remito.'],
  ['Facturación', 'Comprobantes con CAE de ARCA y PDF con QR, desde el mismo lugar donde vendés.'],
  ['Mapa', 'Los clientes y los repartidores ubicados, en vivo.'],
  ['Usuarios', 'Repartidor, depósito, administrador. Cada uno ve lo suyo.'],
  ['Revendedores', 'A quién le llenás y cuánto te debe.'],
  ['Panel del dueño', 'Cobrado, vendido, bidones y quién hace rato que no compra.'],
];

const conservacion: [string, string][] = [
  ['Sin señal', 'El repartidor carga la venta igual. Cuando vuelve la conexión se sincroniza solo.'],
  ['Sin instalación', 'Entrás desde el navegador o la instalás como app en el celular.'],
  ['Sin permanencia', 'No hay contrato ni costo de puesta en marcha. Cortás cuando quieras.'],
  ['Varias empresas', 'Si manejás más de una, cada una con sus módulos, sus usuarios y su caja.'],
];
---

<section id="contenido" class="scroll-mt-20 bg-label-100 py-20 sm:py-28">
  <div class="mx-auto max-w-[1180px] px-5 sm:px-9">
    <div class="etiqueta" data-reveal>
      <div class="flex flex-wrap items-baseline justify-between gap-x-6 gap-y-1 border-b border-label-200 px-5 py-3 sm:px-9">
        <p class="t-legal text-[11px] text-ink">Contenido</p>
        <p class="t-legal text-[11px] text-inksoft">12 módulos · Todos incluidos</p>
      </div>

      <div class="px-5 py-9 sm:px-9 sm:py-12">
        <h2 class="t-marca max-w-[18ch] text-[2rem] text-ink sm:text-[2.75rem]">
          Todo lo que hoy está en el cuaderno
        </h2>
        <p class="mt-5 max-w-[54ch] text-[1.0625rem] leading-relaxed text-inksoft">
          No hay plan chico al que le falten cosas: cualquier distribuidora entra
          con todo prendido. Lo que cambia es cuántos usuarios y clientes tenés.
        </p>

        <dl class="rayado mt-10 border-y border-label-200 sm:columns-2 sm:gap-x-12">
          {
            modulos.map(([k, v]) => (
              <div class="break-inside-avoid py-3.5">
                <dt class="t-dato text-[0.9375rem] text-ink">{k}</dt>
                <dd class="mt-0.5 max-w-[52ch] text-sm leading-relaxed text-inksoft">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      <!-- Conservación: lo que en un envase va abajo, en letra chica. -->
      <div class="border-t border-label-200 bg-label-100 px-5 py-8 sm:px-9 sm:py-10">
        <p class="t-legal text-[11px] text-ink">Conservación</p>
        <dl class="mt-6 grid gap-x-12 gap-y-6 sm:grid-cols-2 lg:grid-cols-4">
          {
            conservacion.map(([k, v]) => (
              <div>
                <dt class="t-dato text-[0.9375rem] text-ink">{k}</dt>
                <dd class="mt-1 text-sm leading-relaxed text-inksoft">{v}</dd>
              </div>
            ))
          }
        </dl>
      </div>
    </div>
  </div>
</section>
