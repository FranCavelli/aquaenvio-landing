---
/**
 * Video en loop de la app, visto a través del plástico del envase.
 *  - `src`  → archivo en /public (ej: "/videos/dashboard.mp4").
 *  - `poster` → imagen de respaldo mientras carga (ej: "/images/dashboard.jpg").
 * Filo duro y sin radios: es una ventana en el envase, no una card.
 */
interface Props {
  src: string;
  poster?: string;
  label?: string;
  ratio?: string; // clase de aspect-ratio de Tailwind
  class?: string;
  /**
   * Acercar en el celular. Las capturas son de pantallas de 1440 px: metidas
   * en 350 px de ancho, la letra de la app queda en 5 px y no se lee nada.
   * Con esto, en pantallas chicas se muestra agrandada la parte de la
   * izquierda —el menú y la primera columna de datos, que es lo que importa—
   * en vez de todo el escritorio en miniatura.
   */
  acercarEnCelular?: boolean;
}

const {
  src,
  poster,
  label = '',
  ratio = 'aspect-[4/3]',
  class: cls = '',
  acercarEnCelular = false,
} = Astro.props;
---

<div class={`group relative overflow-hidden rounded-[1.125rem] bg-pc-800 ${ratio} ${cls}`}>
  <!-- Fondo mientras no cargó nada. -->
  <div class="absolute inset-0 flex items-center justify-center bg-[linear-gradient(160deg,#0B4FA8_0%,#06305C_100%)] p-4 text-center">
    {label && <span class="t-legal text-[10px] text-pc-200/90">{label}</span>}
  </div>

  <video
    data-src={src}
    data-poster={poster}
    loop
    muted
    playsinline
    preload="none"
    aria-label={label}
    class={`lazy-video absolute inset-0 h-full w-full object-cover ${acercarEnCelular ? 'acercar' : ''}`}></video>

  <!-- Brillo del plástico: una franja de luz cruzando la ventana. -->
  <div
    class="pointer-events-none absolute inset-0 mix-blend-screen"
    aria-hidden="true"
    style="background: linear-gradient(105deg, rgba(155,221,250,.16) 0%, rgba(155,221,250,0) 34%, rgba(155,221,250,0) 68%, rgba(155,221,250,.09) 100%)"
  >
  </div>
</div>

<style>
  /* Acercar en pantallas chicas: la captura es de un escritorio de 1440 px y
     a 350 px de ancho no se lee una letra. Se agranda apoyada en el borde
     izquierdo, que es donde están el menú y los datos. */
  @media (max-width: 1023px) {
    .acercar {
      transform: scale(2.1);
      transform-origin: 6% 30%;
    }
  }
</style>

<script>
  // Lazy-load: cada video carga su fuente y se reproduce SOLO cuando se acerca
  // al viewport (y se pausa al salir). Sin esto se bajaban megas de video en la
  // carga inicial y el LCP se iba a 9 s.
  const io = new IntersectionObserver(
    (entries) => {
      entries.forEach((e) => {
        const v = e.target as HTMLVideoElement;
        if (e.isIntersecting) {
          if (v.dataset.poster && !v.poster) v.poster = v.dataset.poster;
          if (v.dataset.src && !v.src) v.src = v.dataset.src;
          v.play().catch(() => {});
        } else {
          v.pause();
        }
      });
    },
    { rootMargin: '300px 0px' }
  );
  document.querySelectorAll<HTMLVideoElement>('video.lazy-video').forEach((v) => io.observe(v));
</script>
