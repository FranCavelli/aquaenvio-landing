---
import { whatsappUrl } from '../config';

// COMPARACIÓN — la góndola: el mismo panel de datos, cuatro envases al lado.
// Los datos son públicos de cada proveedor y la fecha va abajo, como corresponde.
// true = sí, false = no, string = el detalle.
const features: { f: string; aqua: boolean | string; yaku: boolean | string; gestion: boolean | string; app: boolean | string }[] = [
  { f: 'Precio en pesos', aqua: true, yaku: 'En dólares (USD 48–96/mes)', gestion: 'No publica', app: 'Gratis (muy limitada)' },
  { f: 'Prueba gratis sin tarjeta', aqua: '1 semana', yaku: '7 días', gestion: false, app: true },
  { f: 'Sin costo de puesta en marcha', aqua: true, yaku: 'USD 50–100 aparte', gestion: false, app: true },
  { f: 'App del repartidor', aqua: true, yaku: true, gestion: true, app: true },
  { f: 'Funciona sin señal en la calle', aqua: true, yaku: false, gestion: false, app: false },
  { f: 'Control de envases en comodato', aqua: true, yaku: 'Plan medio o superior', gestion: true, app: true },
  { f: 'Facturación ARCA con CAE real', aqua: true, yaku: false, gestion: false, app: false },
  { f: 'Página de pedidos para tus clientes', aqua: true, yaku: false, gestion: false, app: false },
  { f: 'Cobro por Mercado Pago', aqua: true, yaku: false, gestion: false, app: false },
  { f: 'Copiloto por voz en el reparto', aqua: true, yaku: false, gestion: false, app: false },
  { f: 'Mapa de clientes y repartidores', aqua: true, yaku: true, gestion: 'Parcial', app: 'Parcial' },
  { f: 'Caja y gastos', aqua: true, yaku: true, gestion: true, app: true },
  { f: 'Soporte por WhatsApp', aqua: true, yaku: 'Plan pro', gestion: true, app: 'Limitado en el gratis' },
];

const cols = [
  { key: 'aqua' as const, name: 'Aquaenvio', propio: true },
  { key: 'yaku' as const, name: 'Yaku' },
  { key: 'gestion' as const, name: 'Gestión Aguas' },
  { key: 'app' as const, name: 'App Delivery Agua' },
];
---

<section id="comparativa" class="scroll-mt-20 bg-label-100 pb-20 sm:pb-28">
  <div class="mx-auto max-w-[1180px] px-5 sm:px-9">
    <div class="max-w-2xl" data-reveal>
      <h2 class="t-marca text-[2rem] text-ink sm:text-[2.75rem]">La misma góndola, al lado</h2>
      <p class="mt-5 max-w-[54ch] text-[1.0625rem] leading-relaxed text-inksoft">
        Cómo queda Aquaenvio contra los otros sistemas de reparto de agua que se
        consiguen en Argentina, en lo que le cambia el día a una distribuidora.
      </p>
    </div>

    <!-- El scroll horizontal en el celular: la columna de la izquierda queda
         fija (si no, quedan tildes sueltas sin saber de qué fila son) y el
         borde derecho se desvanece para que se vea que hay más. -->
    <p class="t-legal mt-10 mb-3 text-[10px] text-inksoft sm:hidden">
      Deslizá la tabla para ver el resto
    </p>
    <div class="etiqueta relative mt-0 sm:mt-10" data-reveal>
      <div
        class="pointer-events-none absolute inset-y-0 right-0 z-20 w-12 lg:hidden"
        aria-hidden="true"
        style="background: linear-gradient(90deg, rgba(255,255,255,0), rgba(255,255,255,.95))"
      >
      </div>
      <div class="overflow-x-auto">
      <table class="w-full min-w-[720px] border-collapse text-left">
        <caption class="sr-only">Comparación de Aquaenvio con otros sistemas de reparto de agua</caption>
        <thead>
          <tr class="border-b border-label-200">
            <th scope="col" class="t-legal sticky left-0 z-10 bg-label-50 px-5 py-4 text-[10px] text-inksoft">Característica</th>
            {
              cols.map((c) => (
                <th
                  scope="col"
                  class={`t-legal px-4 py-4 text-center text-[10px] ${c.propio ? 'bg-pc-700 text-white' : 'text-inksoft'}`}
                >
                  {c.name}
                </th>
              ))
            }
          </tr>
        </thead>
        <tbody>
          {
            features.map((row) => (
              <tr class="border-b border-label-200 last:border-b-0">
                <th scope="row" class="sticky left-0 z-10 min-w-[230px] bg-label-50 px-5 py-3 text-left text-sm font-normal text-ink">
                  {row.f}
                </th>
                {cols.map((c) => {
                  const v = row[c.key];
                  return (
                    <td class={`px-4 py-3 text-center ${c.propio ? 'bg-pc-700/[0.07]' : ''}`}>
                      {v === true ? (
                        <>
                          <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" class="inline-block text-pc-700" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>
                          <span class="sr-only">Sí</span>
                        </>
                      ) : v === false ? (
                        <>
                          <span class="inline-block h-px w-4 bg-label-300 align-middle" aria-hidden="true" />
                          <span class="sr-only">No</span>
                        </>
                      ) : (
                        <span class="text-[0.8125rem] text-inksoft">{v}</span>
                      )}
                    </td>
                  );
                })}
              </tr>
            ))
          }
        </tbody>
      </table>
      </div>
    </div>

    <div class="mt-6 flex flex-wrap items-center justify-between gap-6" data-reveal>
      <p class="t-legal text-[10px] text-inksoft">
        La raya significa que no lo tiene · Datos públicos de cada proveedor, junio 2026
      </p>
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="t-legal text-[11px] text-ink underline decoration-2 underline-offset-[6px] transition hover:text-pc-700"
      >
        Preguntar lo que falte
      </a>
    </div>
  </div>
</section>
