---
import { whatsappUrl } from '../config';

/* Comparativa contra los demás sistemas del rubro.
   REGLA: solo se afirma lo que cada proveedor publica en su web (relevado el
   23/09/2026). Si no lo publica, va `null` (X roja con la leyenda "no figura en su web"), nunca `false`:
   decir que otro no tiene algo que sí tiene nos expone. `false` solo cuando
   el plan lo excluye explícitamente. */

type Celda = true | false | null | string;

const cols = [
  { key: 'aqua', name: 'Aquaenvio', highlight: true },
  { key: 'sodapp', name: 'Sodapp' },
  { key: 'yaku', name: 'Yaku' },
  { key: 'ada', name: 'App Delivery Agua' },
  { key: 'gestion', name: 'Gestión Aguas' },
  { key: 'jr', name: 'JR-Software' },
  { key: 'startapp', name: 'Reparto de Agua' },
] as const;

type Col = (typeof cols)[number]['key'];

const features: ({ f: string } & Record<Col, Celda>)[] = [
  { f: 'Sin costo de alta', aqua: true, sodapp: true, yaku: 'Solo anual', ada: null, gestion: null, jr: null, startapp: null },
  { f: 'Sin tope de ventas', aqua: true, sodapp: 'Con tope', yaku: 'Lite: 250', ada: null, gestion: null, jr: null, startapp: null },
  { f: 'App del repartidor', aqua: true, sodapp: true, yaku: true, ada: true, gestion: true, jr: true, startapp: true },
  { f: 'Funciona sin señal', aqua: true, sodapp: null, yaku: null, ada: null, gestion: null, jr: true, startapp: true },
  { f: 'Envases y comodato', aqua: true, sodapp: true, yaku: true, ada: 'Plan pago', gestion: null, jr: true, startapp: true },
  { f: 'Factura AFIP', aqua: true, sodapp: true, yaku: null, ada: 'Plan pago', gestion: 'Sin aclarar', jr: 'Sin aclarar', startapp: true },
  { f: 'Ruta optimizada', aqua: true, sodapp: true, yaku: true, ada: true, gestion: true, jr: true, startapp: null },
  { f: 'Navegación GPS asistida', aqua: true, sodapp: null, yaku: null, ada: null, gestion: null, jr: null, startapp: null },
  { f: 'Pedidos por WhatsApp', aqua: true, sodapp: true, yaku: null, ada: true, gestion: null, jr: null, startapp: null },
  { f: 'Página para tus clientes', aqua: true, sodapp: null, yaku: true, ada: null, gestion: null, jr: true, startapp: null },
  { f: 'Cobro con QR', aqua: true, sodapp: null, yaku: null, ada: null, gestion: null, jr: null, startapp: null },
  { f: 'Abonos mensuales', aqua: true, sodapp: null, yaku: null, ada: null, gestion: null, jr: null, startapp: true },
  { f: 'Venta en mostrador', aqua: true, sodapp: null, yaku: null, ada: null, gestion: null, jr: null, startapp: null },
  { f: 'Copiloto de IA por voz', aqua: true, sodapp: null, yaku: null, ada: null, gestion: null, jr: null, startapp: null },
  { f: 'Caja y gastos', aqua: true, sodapp: null, yaku: null, ada: true, gestion: null, jr: null, startapp: null },
];

---

<section id="comparativa" class="scroll-mt-24 bg-slate-50 py-16 sm:py-24">
  <div class="mx-auto max-w-6xl px-4">
    <!-- ── Funciones ──────────────────────────────────────────────────── -->
    <div class="text-center" data-reveal>
      <span class="text-sm font-semibold text-cyan-600">Comparativa</span>
      <h2 class="mt-2 text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">Funciones, una por una</h2>
    </div>
    <div class="mt-8 overflow-x-auto rounded-2xl border border-slate-200 bg-white shadow-sm" data-reveal>
      <table class="w-full min-w-[920px] border-collapse text-sm">
        <thead>
          <tr class="bg-slate-50">
            <th class="sticky left-0 z-10 bg-slate-50 px-4 py-4 text-left font-semibold text-slate-500">Función</th>
            {cols.map((c) => (
              <th class={`px-3 py-4 text-center font-bold leading-tight ${c.highlight ? 'bg-aqua-700 text-white' : 'text-slate-700'}`}>
                {c.name}
              </th>
            ))}
          </tr>
        </thead>
        <tbody>
          {features.map((row, i) => (
            <tr class={i % 2 ? 'bg-white' : 'bg-slate-50/40'}>
              <td class={`sticky left-0 z-10 max-w-[13rem] px-4 py-3 text-left font-medium text-slate-700 ${i % 2 ? 'bg-white' : 'bg-slate-50'}`}>{row.f}</td>
              {cols.map((c) => {
                const v = row[c.key];
                return (
                  <td class={`px-3 py-3 text-center ${c.highlight ? 'bg-cyan-50/70 font-medium text-aqua-900' : 'text-slate-600'}`}>
                    {v === true ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-emerald-100 text-emerald-600" title="Sí">
                        <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>
                      </span>
                    ) : v === false ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-slate-100 text-slate-300" title="No">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                      </span>
                    ) : v === null ? (
                      <span class="inline-flex h-6 w-6 items-center justify-center rounded-full bg-red-100 text-red-500" title="No figura en su web">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
                      </span>
                    ) : (
                      <span class="text-xs leading-tight">{v}</span>
                    )}
                  </td>
                );
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-center text-xs text-slate-400">
      ✗ = no figura en la web del proveedor. Relevado de la web de cada proveedor el 23/09/2026.
    </p>

    <!-- ── ¿Y una app de rutas común? ─────────────────────────────────── -->
    <div class="mt-14 rounded-2xl border border-slate-200 bg-white p-6 shadow-sm sm:p-8" data-reveal>
      <h3 class="text-lg font-bold text-slate-900">¿Y si uso una app de rutas común, como SimpliRoute o Spoke (ex Circuit)?</h3>
      <p class="mt-2 text-sm text-slate-600">
        Te ordenan las paradas, y ahí termina. No llevan cuántos bidones tiene prestados cada cliente,
        cuánto te debe ni qué precio le hacés, y no te sacan la factura. Terminás con la app de rutas,
        la planilla y el cuaderno. Aquaenvio es todo eso junto.
      </p>
    </div>

    <!-- Lo que te llevás con Aquaenvio -->
    <div class="mt-5 grid gap-5 sm:grid-cols-3" data-reveal-group>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-reveal-item>
        <div class="text-2xl">💸</div>
        <h3 class="mt-3 font-bold text-slate-800">Pagás por tu tamaño</h3>
        <p class="mt-1.5 text-sm text-slate-500">Sin planes que te cortan a los 250 pedidos ni cobro por venta extra. Crecés y el precio acompaña de a poco.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-reveal-item>
        <div class="text-2xl">📲</div>
        <h3 class="mt-3 font-bold text-slate-800">Cobro con QR en la puerta</h3>
        <p class="mt-1.5 text-sm text-slate-500">El repartidor muestra el QR de Mercado Pago y la venta queda cobrada. Sin anotar transferencias a mano.</p>
      </div>
      <div class="rounded-2xl border border-slate-200 bg-white p-6 shadow-sm" data-reveal-item>
        <div class="text-2xl">🎙️</div>
        <h3 class="mt-3 font-bold text-slate-800">Copiloto de IA por voz</h3>
        <p class="mt-1.5 text-sm text-slate-500">Le dice al repartidor a quién venderle más y qué clientes están flojos, mientras maneja.</p>
      </div>
    </div>


    <p class="mt-8 text-center text-sm" data-reveal>
      <a href="/comparativa/" class="inline-flex items-center gap-1 font-semibold text-cyan-700 transition hover:text-cyan-800 hover:underline">
      Ver la comparativa completa, función por función
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </p>
    <div class="mt-10 text-center" data-reveal>
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 rounded-full bg-blue-600 px-7 py-3.5 text-sm font-semibold text-white shadow-lg shadow-blue-600/30 transition hover:-translate-y-0.5 hover:bg-blue-700">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"/></svg>
        Probar Aquaenvio gratis
      </a>
    </div>
  </div>
</section>

