---
/**
 * Burbujas que suben en las secciones de plástico.
 *
 * Es lo que hace que el azul se lea como AGUA y no como un fondo azul
 * cualquiera. Van muy tenues y lentas: se notan sin molestar la lectura, y se
 * frenan solas si el sistema pide menos movimiento.
 */
interface Props {
  cantidad?: number;
}
const { cantidad = 14 } = Astro.props;

// Posición, tamaño, demora y duración: fijas, para que el render del server y
// el del cliente sean el mismo.
const burbujas = Array.from({ length: cantidad }, (_, i) => ({
  left: ((i * 37) % 97) + 1.5,
  size: 4 + ((i * 5) % 11),
  delay: (i * 1.9) % 16,
  dur: 13 + ((i * 3) % 9),
}));
---

<div class="burbujas pointer-events-none absolute inset-0 overflow-hidden" aria-hidden="true">
  {
    burbujas.map((b) => (
      <span
        style={`left:${b.left}%; width:${b.size}px; height:${b.size}px; animation-delay:-${b.delay}s; animation-duration:${b.dur}s`}
      />
    ))
  }
</div>
