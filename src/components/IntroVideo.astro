---
import { PRECIO_MINIMO_ARS } from '../config';
const piso = '$' + PRECIO_MINIMO_ARS.toLocaleString('es-AR');
/**
 * Sección de video de introducción.
 * El archivo va en /public/videos/intro.mp4 (poster en /public/images/intro-poster.jpg).
 * El video arranca "sellado": marco con degradé, botón de play grande al centro
 * y sin la barra de controles; los controles nativos aparecen recién al dar play.
 */
---

<section id="video" class="mx-auto max-w-6xl scroll-mt-24 px-4 py-16 sm:py-24">
  <div class="mx-auto max-w-2xl text-center" data-reveal>
    <span class="text-sm font-semibold text-cyan-600">Mirá cómo funciona</span>
    <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-900 sm:text-4xl">
      Aquaenvio en 45 segundos
    </h2>
    <p class="mt-3 text-slate-500">
      De las hojas que se pierden al reparto ordenado: mirá cómo trabaja una
      distribuidora con Aquaenvio.
    </p>
  </div>

  <!-- Marco: recuadro con degradé de la marca alrededor del player -->
  <div
    class="mx-auto mt-10 w-full max-w-4xl rounded-[2rem] bg-gradient-to-br from-cyan-400 via-cyan-600 to-aqua-900 p-1.5 shadow-2xl"
    data-reveal
  >
    <div class="relative aspect-video w-full overflow-hidden rounded-[1.65rem] bg-slate-900">
      <video
        id="intro-player"
        class="absolute inset-0 h-full w-full bg-transparent object-cover"
        playsinline
        preload="metadata"
        poster="/images/intro-poster.jpg"
        onerror="this.style.display='none'"
      >
        <source src="/videos/intro.mp4" type="video/mp4" />
      </video>

      <!-- Botón de play al centro: se rompe el sello y aparecen los controles -->
      <button
        id="intro-play"
        type="button"
        aria-label="Reproducir la presentación de Aquaenvio"
        class="group absolute inset-0 flex cursor-pointer items-center justify-center bg-slate-950/25 transition hover:bg-slate-950/10"
      >
        <span
          class="flex h-20 w-20 items-center justify-center rounded-full bg-white/20 ring-2 ring-white/40 backdrop-blur transition group-hover:scale-110 group-hover:bg-white/30 sm:h-24 sm:w-24"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="currentColor" class="ml-1.5 text-white drop-shadow">
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </span>
      </button>
    </div>
  </div>

  <!-- El precio pegado al video: es lo que más nos separa (pedido de Francisco 14/10/2026).
       Sale del mismo piso que la calculadora, así no queda desactualizado. -->
  <div class="mt-8 flex flex-col items-center gap-4 rounded-3xl bg-gradient-to-br from-aqua-800 to-aqua-900 px-6 py-7 text-center text-white sm:flex-row sm:justify-between sm:text-left" data-reveal>
    <div>
      <p class="text-sm font-medium text-cyan-200">Nunca fue tan accesible ordenar tu reparto</p>
      <p class="mt-1 text-3xl font-extrabold tracking-tight sm:text-4xl">Todo incluido desde {piso}<span class="text-lg font-semibold text-cyan-100"> /mes</span></p>
      <p class="mt-1 text-sm text-cyan-100/80">Sin costo de alta, sin límite de productos. La primera semana es gratis.</p>
    </div>
    <a href="#calculadora" class="shrink-0 rounded-full bg-white px-6 py-3 text-sm font-semibold text-aqua-900 shadow-lg transition hover:-translate-y-0.5">Calculá tu precio</a>
  </div>
</section>

<script>
  const video = document.getElementById('intro-player') as HTMLVideoElement | null;
  const play = document.getElementById('intro-play');
  if (video && play) {
    play.addEventListener('click', () => {
      video.controls = true;
      video.play().catch(() => {});
      play.remove();
    });
    // Al terminar vuelve el poster; los controles quedan por si quiere repetirlo.
    video.addEventListener('ended', () => {
      video.load();
    });
  }
</script>
