---
import { whatsappUrl, mailtoUrl } from '../config';
const year = new Date().getFullYear();

// LA LETRA CHICA DEL FONDO DEL ENVASE. Todo en versalitas y chico, como el
// bloque legal que nadie lee pero que siempre está.
---

<footer class="border-t border-label-300 bg-label-50">
  <div class="mx-auto max-w-[1180px] px-5 py-10 sm:px-9">
    <div class="flex flex-wrap items-center justify-between gap-x-8 gap-y-5">
      <a href="/" class="flex items-center gap-2.5 text-ink">
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7 16.3c2.2 0 4-1.83 4-4.05 0-1.16-.57-2.26-1.71-3.19S7.29 6.75 7 5.3c-.29 1.45-1.14 2.84-2.29 3.76S3 11.1 3 12.25c0 2.22 1.8 4.05 4 4.05z"></path><path d="M12.56 6.6A10.97 10.97 0 0 0 14 3.02c.5 2.5 2 4.9 4 6.5s3 3.5 3 5.5a6.98 6.98 0 0 1-11.91 4.97"></path></svg>
        <span class="t-legal text-[13px]">Aquaenvio</span>
      </a>

      <!-- Con barra final: sin ella cada visita (y cada rastreo de Google) se
           come un 301 al vicio, porque así las sirve GitHub Pages. -->
      <nav class="flex flex-wrap items-center gap-x-7 gap-y-2" aria-label="Páginas">
        <a href="/funciones/" class="t-legal text-[10.5px] text-inksoft transition hover:text-ink">Funciones</a>
        <a href="/precio/" class="t-legal text-[10.5px] text-inksoft transition hover:text-ink">Precio</a>
        <a href="/comparativa/" class="t-legal text-[10.5px] text-inksoft transition hover:text-ink">Comparativa</a>
      </nav>

      <div class="flex flex-wrap items-center gap-x-7 gap-y-2">
        <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="t-legal text-[10.5px] text-ink underline decoration-2 underline-offset-[6px] transition hover:text-pc-700">WhatsApp</a>
        <a href={mailtoUrl} class="t-legal text-[10.5px] text-ink underline decoration-2 underline-offset-[6px] transition hover:text-pc-700">Mail</a>
      </div>
    </div>

    <p class="t-legal mt-8 border-t border-label-200 pt-5 text-[10px] leading-[1.8] text-inksoft">
      © {year} Aquaenvio · Software de gestión para distribuidoras de agua ·
      Hecho en Argentina · Precios en pesos, sujetos a la cotización del día ·
      Las marcas de terceros que se mencionan pertenecen a sus dueños
    </p>
  </div>
</footer>
