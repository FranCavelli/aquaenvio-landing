---
import Burbujas from './Burbujas.astro';

/**
 * La presentación en video — 45 segundos con voz, el primer vistazo después
 * del hero. A diferencia de los VideoTile (loops mudos de la app), este se
 * reproduce CON audio cuando el visitante lo pide: por eso no arranca solo,
 * tiene su botón-precinto y recién ahí carga el archivo (5 MB que no pesan
 * en el LCP).
 */
---

<section id="presentacion" class="relative overflow-hidden bg-pc-900 py-16 sm:py-24">
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
    style="background: linear-gradient(180deg, #0B4FA8 0%, #06305C 55%, #041B33 100%)"
  >
  </div>
  <Burbujas cantidad={10} />

  <div class="relative mx-auto max-w-[1020px] px-5 sm:px-9">
    <div class="text-center" data-reveal>
      <p class="t-legal text-[10px] text-luz">La presentación</p>
      <h2 class="t-marca serigrafia mt-3 text-[2rem] sm:text-5xl">Aquaenvio en 45 segundos</h2>
      <p class="mx-auto mt-4 max-w-[52ch] leading-relaxed text-pc-100/90">
        De las hojas que se vuelan a la venta cargada en la calle y el día
        cerrado solo: así trabaja una distribuidora con Aquaenvio.
      </p>
    </div>

    <figure class="mt-10 rounded-[1.5rem] border border-pc-200/25 p-2" data-reveal>
      <div class="relative overflow-hidden rounded-[1.125rem] bg-pc-950">
        <video
          id="video-intro"
          data-src="/videos/intro.mp4"
          poster="/images/intro-poster.jpg"
          preload="none"
          playsinline
          class="block aspect-video h-auto w-full"></video>

        <!-- Brillo del plástico sobre la ventana. -->
        <div
          class="pointer-events-none absolute inset-0 mix-blend-screen"
          aria-hidden="true"
          style="background: linear-gradient(105deg, rgba(155,221,250,.16) 0%, rgba(155,221,250,0) 34%, rgba(155,221,250,0) 68%, rgba(155,221,250,.09) 100%)"
        >
        </div>

        <!-- El precinto que se rompe para mirar. -->
        <button
          id="btn-intro"
          type="button"
          aria-label="Reproducir la presentación de Aquaenvio"
          class="absolute inset-0 flex cursor-pointer items-center justify-center bg-pc-950/30 transition hover:bg-pc-950/15"
        >
          <span class="precinto t-legal inline-flex items-center gap-2.5 px-7 py-4 text-[12px]">
            <svg width="14" height="14" viewBox="0 0 14 14" aria-hidden="true">
              <path d="M2 1.5 L12.5 7 L2 12.5 Z" fill="currentColor"></path>
            </svg>
            Ver la presentación · 45 s
          </span>
        </button>
      </div>
    </figure>
  </div>
</section>

<script>
  const v = document.getElementById('video-intro') as HTMLVideoElement | null;
  const b = document.getElementById('btn-intro');
  if (v && b) {
    b.addEventListener('click', () => {
      if (!v.src) v.src = v.dataset.src || '';
      v.controls = true;
      v.play().catch(() => {});
      b.remove();
    });
    // Al terminar, vuelve el poster (los controles quedan por si quiere repetirlo).
    v.addEventListener('ended', () => {
      v.load();
    });
  }
</script>
