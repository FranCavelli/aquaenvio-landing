---
/**
 * Botón de WhatsApp FIJO abajo, solo en el celular (Clarity 12-14/10/2026: de
 * 365 visitas en el celular, solo 3 tocaron WhatsApp; el de arriba es chico y el
 * del final casi nadie lo alcanza). Aparece después de pasar el inicio, para no
 * tapar el primer golpe de vista. El toque lo mide el embudo (es un wa.me).
 */
import { whatsappUrl } from '../config';
---
<a
  id="wa-fijo"
  href={whatsappUrl}
  target="_blank"
  rel="noopener noreferrer"
  aria-label="Escribinos por WhatsApp"
  class="fixed inset-x-4 bottom-4 z-50 flex translate-y-24 items-center justify-center gap-2 rounded-full bg-[#25D366] px-5 py-3.5 text-base font-semibold text-white opacity-0 shadow-xl shadow-black/25 transition duration-300 sm:hidden"
  style="padding-bottom: max(0.875rem, env(safe-area-inset-bottom));"
>
  <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
  Escribinos por WhatsApp
</a>
<script is:inline>
  (function () {
    try {
      var b = document.getElementById('wa-fijo');
      var hero = document.getElementById('top');
      if (!b || !hero) return;
      var mostrar = function (si) {
        b.style.opacity = si ? '1' : '0';
        b.style.transform = si ? 'translateY(0)' : 'translateY(6rem)';
        b.style.pointerEvents = si ? 'auto' : 'none';
      };
      mostrar(false);
      new IntersectionObserver(function (e) { mostrar(!e[0].isIntersecting); }, { threshold: 0.35 }).observe(hero);
    } catch (e) {}
  })();
</script>
