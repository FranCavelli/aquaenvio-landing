---
import Bidon from './Bidon.astro';

// Encabezado de las páginas sueltas: la etiqueta con el envase adentro.
//
// El envase va DENTRO del panel, a la derecha: puesto arriba y suelto dejaba
// medio papel en blanco y el bidón solo en el medio del azul.
// El "badge" es la denominación de la etiqueta, en la cabecera del papel.
interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
}
const { badge, title, subtitle } = Astro.props;
---

<section class="relative overflow-hidden bg-pc-900 pb-16">
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
    style="background: radial-gradient(120% 90% at 50% 0%, #1478E0 0%, #0B4FA8 34%, #06305C 62%, #041B33 88%)"
  >
  </div>

  <div class="relative mx-auto max-w-[1180px] px-5 pt-32 sm:px-6">
    <div class="etiqueta relative">
      <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-1 border-b border-label-200 px-6 py-3.5 sm:px-10">
        <p class="t-legal text-[11px] text-ink">Aquaenvio</p>
        {badge && <p class="t-legal text-[11px] text-inksoft">{badge}</p>}
      </div>

      <div class="grid items-center gap-8 px-6 py-11 sm:px-10 sm:py-14 lg:grid-cols-[1fr_minmax(0,190px)] lg:gap-14">
        <div class="min-w-0">
          <h1 class="t-marca max-w-[20ch] text-[2.1rem] text-ink sm:text-[3.25rem]">{title}</h1>
          {subtitle && <p class="mt-6 max-w-[54ch] text-[1.0625rem] leading-relaxed text-inksoft">{subtitle}</p>}
        </div>

        <div class="hidden justify-self-center lg:block">
          <Bidon marca="Aquaenvio" bajada="Software de reparto" class="w-[170px]" id="bidon-pagina" />
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* Acá el envase está quieto: no hay scroll que lo llene, así que se muestra
     lleno de entrada. */
  section :global(.bidon) {
    --nivel: 0.82;
  }
</style>
