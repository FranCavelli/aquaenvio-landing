---
import { whatsappUrl, mailtoUrl } from '../config';
import Bidon from './Bidon.astro';
import Burbujas from './Burbujas.astro';

// EL CIERRE — el envase lleno, y abrirlo.
---

<section id="contacto" class="relative overflow-hidden bg-pc-900">
  <div
    class="pointer-events-none absolute inset-0"
    aria-hidden="true"
    style="background: radial-gradient(100% 90% at 50% 100%, #1478E0 0%, #0B4FA8 38%, #041B33 88%)"
  >
  </div>
  <Burbujas cantidad={10} />

  <!-- El envase otra vez, ya lleno: el final de la página es abrirlo. -->
  <div class="relative flex justify-center pt-20">
    <Bidon marca="Aquaenvio" bajada="Software de reparto" class="w-[104px] sm:w-[128px]" id="bidon-cierre" />
  </div>

  <div class="relative mx-auto max-w-[1180px] px-5 pb-24 pt-10 text-center sm:px-9" data-reveal>
    <h2 class="t-marca serigrafia mx-auto max-w-[15ch] text-[2.2rem] sm:text-[3.5rem]">
      Abrilo y probalo una semana
    </h2>
    <p class="mx-auto mt-6 max-w-[50ch] leading-relaxed text-pc-100/90">
      Escribinos y la dejamos andando con tus clientes cargados, para que la
      pruebes con tu reparto de verdad. No hace falta tarjeta ni firmar nada.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-x-8 gap-y-4">
      <a
        href={whatsappUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="precinto t-legal inline-flex items-center gap-2.5 px-9 py-4.5 text-[12px]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
        Escribir por WhatsApp
      </a>
      <a
        href={mailtoUrl}
        class="t-legal text-[12px] text-white underline decoration-2 underline-offset-[7px] transition hover:text-luz"
      >
        O mandar un mail
      </a>
    </div>
  </div>
</section>

<style>
  /* Acá el envase ya está lleno: es el final del recorrido. */
  section :global(.bidon) {
    --nivel: 0.9;
  }
</style>
