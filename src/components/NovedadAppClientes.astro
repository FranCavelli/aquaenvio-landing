---
// Novedad de la portada (31/10/2026): salió Aquaenvio Clientes. Lleva a /app,
// que es la página para compartir con los clientes de cada distribuidora.
---

<section id="novedad-app-clientes" class="bg-white py-10 sm:py-14">
  <div class="mx-auto max-w-5xl px-4">
    <div class="relative overflow-hidden rounded-3xl bg-gradient-to-br from-aqua-900 via-aqua-800 to-aqua-700 p-7 text-white sm:p-10">
      <div class="pointer-events-none absolute -right-16 -top-16 h-64 w-64 rounded-full bg-cyan-400/25 blur-3xl"></div>
      <div class="relative grid items-center gap-8 md:grid-cols-[1fr_auto]">
        <div>
          <span class="inline-flex items-center rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-wide text-cyan-100 ring-1 ring-white/20">Nuevo · Ya en el App Store</span>
          <h2 class="mt-4 text-2xl font-extrabold tracking-tight sm:text-4xl">Tus clientes, con <span class="text-cyan-300">su propia app</span></h2>
          <p class="mt-3 max-w-xl text-cyan-100/85">
            Con Aquaenvio Clientes, cada cliente ve su saldo y sus envases, te pide lo de siempre y te paga desde el celular, sin mandarte un WhatsApp.
            Está para iPhone y Android.
          </p>
          <div class="mt-6 flex flex-wrap gap-3">
            <a href="/app/" class="inline-flex h-11 items-center rounded-xl bg-white px-5 font-semibold text-aqua-900 hover:bg-cyan-50">Ver la app y descargarla</a>
          </div>
        </div>
        <img src="/images/app-clientes/saldo.webp" alt="Aquaenvio Clientes: saldo y envases" width="540" height="1100" loading="lazy"
             class="mx-auto w-40 rotate-[-4deg] rounded-[1.6rem] border-[6px] border-slate-950 shadow-2xl sm:w-48" />
      </div>
    </div>
  </div>
</section>
