---
import { whatsappUrl } from '../config';

// INFORMACIÓN DEL PLAN — el precio en el panel de datos del envase.
//
// Todo envase tiene su tabla de información: filete grueso arriba, renglones
// con línea fina, la cifra grande y la letra chica abajo. El precio de acá se
// lee igual, y se calcula con la misma fórmula que usa la app.
// Los IDs (calc-*) los toma src/scripts/calculator.ts: no cambiarlos.
---

<section id="plan" class="scroll-mt-20 bg-label-100 py-20 sm:py-28">
  <div class="mx-auto max-w-[1180px] px-5 sm:px-9">
    <div class="grid gap-10 lg:grid-cols-[1fr_minmax(0,420px)] lg:gap-16" data-reveal>
      <!-- Lo que decide el precio. -->
      <div>
        <h2 class="t-marca max-w-[16ch] text-[2rem] text-ink sm:text-[2.75rem]">
          Pagás por el tamaño de tu distribuidora
        </h2>
        <p class="mt-5 max-w-[54ch] text-[1.0625rem] leading-relaxed text-inksoft">
          No hay planes con funciones recortadas. Movés los dos valores que de
          verdad cambian el costo y el número se arma solo, en pesos, con la
          cotización del día.
        </p>

        <div class="mt-10 space-y-9">
          <div>
            <div class="mb-3 flex items-end justify-between gap-4">
              <label class="t-legal text-[10.5px] text-ink" for="calc-usuarios-num">
                Usuarios <span class="text-inksoft">· repartidores, depósito y admin</span>
              </label>
              <input
                id="calc-usuarios-num"
                type="number"
                value="1"
                min="1"
                max="30"
                class="num w-20 border-b border-label-200 bg-transparent px-1 py-0.5 text-right text-lg font-bold text-ink outline-none"
              />
            </div>
            <input id="calc-usuarios" type="range" value="1" min="1" max="30" step="1" aria-label="Cantidad de usuarios" class="w-full cursor-pointer" />
            <div class="t-legal mt-2 flex justify-between text-[10px] text-inksoft"><span>1</span><span>30 o más</span></div>
          </div>

          <div>
            <div class="mb-3 flex items-end justify-between gap-4">
              <label class="t-legal text-[10.5px] text-ink" for="calc-clientes-num">
                Clientes <span class="text-inksoft">· cargados en el sistema</span>
              </label>
              <input
                id="calc-clientes-num"
                type="number"
                value="300"
                min="0"
                max="3000"
                step="10"
                class="num w-20 border-b border-label-200 bg-transparent px-1 py-0.5 text-right text-lg font-bold text-ink outline-none"
              />
            </div>
            <input id="calc-clientes" type="range" value="300" min="0" max="3000" step="10" aria-label="Cantidad de clientes" class="w-full cursor-pointer" />
            <div class="t-legal mt-2 flex justify-between text-[10px] text-inksoft"><span>0</span><span>3.000 o más</span></div>
          </div>
        </div>
      </div>

      <!-- El panel de información, como en el dorso del envase. -->
      <div class="etiqueta self-start">
        <div class="border-b-2 border-ink/85 px-6 py-4">
          <p class="t-marca text-[1.35rem] text-ink">Información del plan</p>
          <p class="t-legal mt-1 text-[10px] text-inksoft">Porción: 1 distribuidora · por mes</p>
        </div>

        <div class="px-6">
          <div class="flex items-end justify-between gap-4 border-b border-label-200 py-4">
            <span class="t-legal pb-1 text-[10.5px] text-ink">Precio mensual</span>
            <span id="calc-ars" class="num t-marca text-[2.35rem] leading-none text-ink">—</span>
          </div>

          <div class="rayado border-b border-label-200">
            <div class="flex items-baseline justify-between gap-4 py-3">
              <span class="text-sm text-inksoft">En dólares, al blue del día</span>
              <span id="calc-usd" class="num text-sm font-bold text-ink">US$ 0</span>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <span class="text-sm text-inksoft">Tus 2 primeros meses</span>
              <span id="calc-bonificado" class="num text-right text-sm font-bold text-ink">—</span>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <span class="text-sm text-inksoft">Primera semana</span>
              <span class="text-sm font-bold text-ink">Sin cargo</span>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <span class="text-sm text-inksoft">Puesta en marcha</span>
              <span class="text-sm font-bold text-ink">$ 0</span>
            </div>
            <div class="flex items-baseline justify-between gap-4 py-3">
              <span class="text-sm text-inksoft">Permanencia</span>
              <span class="text-sm font-bold text-ink">No tiene</span>
            </div>
          </div>

          <p class="py-4 text-[0.8125rem] leading-relaxed text-inksoft">
            Incluye los 12 módulos, las actualizaciones y el soporte por
            WhatsApp. <span id="calc-loading" class="text-inksoft">Cargando cotización…</span>
          </p>
        </div>

        <div class="border-t border-label-200 p-6">
          <a
            href={whatsappUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="precinto precinto-tinta t-legal flex w-full items-center justify-center gap-2.5 px-6 py-4 text-[12px] transition hover:brightness-105 active:translate-y-px"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M7.9 20A9 9 0 1 0 4 16.1L2 22Z"></path></svg>
            Empezar la semana gratis
          </a>
        </div>
      </div>
    </div>

    <p class="t-legal mt-8 text-[10px] text-inksoft">
      Precio estimado sujeto a confirmación · Se actualiza con la cotización del dólar del día
    </p>
  </div>
</section>

<script>
  import '../scripts/calculator.ts';
</script>
